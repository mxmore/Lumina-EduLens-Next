# ============================================================
# EduLens-Next Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/edulens
POSTGRES_PASSWORD=password

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Object Storage ───────────────────────────────────────────
# Set STORAGE_MODE=minio for local dev, STORAGE_MODE=azure for production.
STORAGE_MODE=minio

# Minio (local dev)
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_SECURE=false

# Azure Blob Storage (production)
# STORAGE_MODE=azure
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# ── Azure OpenAI ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# Embeddings model deployment name
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# ── Azure AI Vision (optional – GPT-4o used as fallback) ─────
AZURE_VISION_ENDPOINT=https://your-vision.cognitiveservices.azure.com/
AZURE_VISION_KEY=your_azure_vision_key_here

# ── LLM settings ─────────────────────────────────────────────
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# ── App settings ─────────────────────────────────────────────
# Automatically apply DB schema on startup (set false in prod after first run)
AUTO_MIGRATE=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
